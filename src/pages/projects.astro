---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import Prose from '../components/Prose.astro';
import { formatRange, formatYm } from '../lib/dates';

// Research projects (kind: research) are listed on the Research page, so this page lists build projects only.
const projects = (await getCollection('projects'))
  .map((e) => e.data)
  .filter((p) => p.kind === 'build')
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

const rangeOf = (p: { start?: string; end?: string }) =>
  p.start ? formatRange(p.start, p.end) : p.end ? formatYm(p.end) : undefined;
---
<Base title="Projects">
  <h1>Projects</h1>
  <ul class="entries">
    {projects.map((p) => (
      <li>
        <Entry heading={p.title} sub={p.tags.length > 0 ? p.tags.join(', ') : undefined} range={rangeOf(p)}>
          <Prose md={p.summary} />
          {p.image && <img src={p.image} alt={p.image_alt} loading="lazy" />}
          {p.links.length > 0 && (
            <p class="meta">
              {p.links.map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={l.url}>{l.label}</a>
                </>
              ))}
            </p>
          )}
        </Entry>
      </li>
    ))}
  </ul>

  <style>
    .entries img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 0 0 0.75rem;
    }
  </style>
</Base>
