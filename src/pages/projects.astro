---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import Prose from '../components/Prose.astro';
import { formatRange, formatYm } from '../lib/dates';

const projects = (await getCollection('projects'))
  .map((e) => e.data)
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title));

const LINKS = [
  { label: 'Code', key: 'code' },
  { label: 'Paper', key: 'paper' },
  { label: 'Demo', key: 'demo' },
] as const;

const rangeOf = (p: { start?: string; end?: string }) =>
  p.start ? formatRange(p.start, p.end) : p.end ? formatYm(p.end) : undefined;
---
<Base title="Projects">
  <h1>Projects</h1>
  <ul class="entries">
    {projects.map((p) => (
      <li>
        <Entry heading={p.title} sub={p.tags.length > 0 ? p.tags.join(', ') : undefined} range={rangeOf(p)}>
          <Prose md={p.summary} />
          {p.image && <img src={p.image} alt={p.image_alt} loading="lazy" />}
          {LINKS.some((l) => p.links?.[l.key]) && (
            <p class="meta">
              {LINKS.filter((l) => p.links?.[l.key]).map((l, i) => (
                <>
                  {i > 0 && ' · '}
                  <a href={p.links?.[l.key]}>{l.label}</a>
                </>
              ))}
            </p>
          )}
        </Entry>
      </li>
    ))}
  </ul>

  <style>
    .entries {
      list-style: none;
    }

    .entries li {
      margin-top: 2rem;
    }

    .entries img {
      display: block;
      max-width: 100%;
      height: auto;
      margin: 0 0 0.75rem;
    }
  </style>
</Base>
