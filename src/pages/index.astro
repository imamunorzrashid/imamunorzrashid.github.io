---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Prose from '../components/Prose.astro';
import { formatYm, ymSortKey } from '../lib/dates';
import { homeLinks } from '../lib/links';
import LinkIcon from '../components/LinkIcon.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing src/content/pages/profile.yaml (collection "profile", id "profile")');
const p = profile.data;

const news = (await getCollection('news'))
  .sort((a, b) => ymSortKey(b.data.date) - ymSortKey(a.data.date))
  .slice(0, 5);

const shownLinks = homeLinks(p);
---
<Base title={p.name} description={`${p.title}, ${p.affiliation}`}>
  <script is:inline>
    {
      // Old one-page anchors (possibly in sent emails) map to their new pages. location.replace keeps the back button usable.
      const oldHashes = {
        '#research': '/research/',
        '#publications': '/publications/',
        '#projects': '/projects/',
        '#gallery': '/gallery/',
        '#education': '/about/#education',
        '#leadership': '/about/#work',
        '#industry': '/about/#work',
        '#honors': '/about/#recognition',
        '#certifications': '/about/#recognition',
      };
      const target = oldHashes[location.hash];
      if (target) location.replace(target);
    }
  </script>

  <section class="intro">
    <img class="photo" src={p.photo} alt={p.photo_alt} width="160" height="160" />
    <div>
      <h1>{p.name}</h1>
      <p class="meta">{p.title}</p>
      <p class="meta">{p.affiliation}</p>
      {p.seeking && <p>{p.seeking}</p>}
    </div>
  </section>

  <section class="section">
    <Prose md={p.bio} />
    <p class="text-links">
      {shownLinks.map((l, i) => (
        <>
          {i > 0 && ' · '}
          <a href={l.href} class="with-icon">{l.icon && <LinkIcon name={l.icon} />} {l.label}</a>
        </>
      ))}
    </p>
    {p.audience_line && (
      <div class="audience">
        <Prose md={p.audience_line} />
      </div>
    )}
  </section>

  {p.interests.length > 0 && (
    <section class="section">
      <h2>Research Interests</h2>
      <p>{p.interests.join(', ')}</p>
    </section>
  )}

  {p.now && (
    <section class="section">
      <h2>Now</h2>
      {p.now_date && <p class="meta">As of {formatYm(p.now_date)}</p>}
      <Prose md={p.now} />
    </section>
  )}

  {news.length > 0 && (
    <section class="section">
      <h2>News</h2>
      <ul class="news">
        {news.map((n) => (
          <li>
            <span class="meta">{formatYm(n.data.date)}</span>
            {n.data.link ? (
              <a href={n.data.link}><Prose md={n.data.text} inline /></a>
            ) : (
              <Prose md={n.data.text} inline />
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  <style>
    .intro {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .photo {
      width: 160px;
      height: 160px;
      flex: none;
      object-fit: cover;
      border-radius: 4px;
    }

    @media (min-width: 768px) {
      .intro {
        flex-direction: row;
        align-items: flex-start;
      }
    }

    .news {
      list-style: none;
    }

    .news li {
      margin-bottom: 0.75rem;
    }

    .news .meta {
      margin-right: 0.75rem;
    }
  </style>
</Base>
