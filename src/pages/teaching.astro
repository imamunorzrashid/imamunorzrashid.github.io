---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import Prose from '../components/Prose.astro';
import { formatRange, ymSortKey } from '../lib/dates';

const page = await getEntry('teachingPage', 'teachingPage');
if (!page) throw new Error('Missing src/content/pages/teaching.yaml (collection "teachingPage", id "teachingPage")');
const t = page.data;

const roles = (await getCollection('teaching'))
  .map((e) => e.data)
  // Ongoing roles (no end) sort first: ymSortKey(undefined) is Infinity, and Infinity - Infinity is NaN, so the start tie-break applies.
  .sort((a, b) => ymSortKey(b.end) - ymSortKey(a.end) || ymSortKey(b.start) - ymSortKey(a.start));

const hasCourses = t.course_groups.length > 0;
---
<Base title="Teaching">
  <h1>Teaching</h1>

  <section class="section">
    <h2>Teaching Statement</h2>
    <Prose md={t.statement} />
  </section>

  {roles.length > 0 && (
    <section class="section">
      <h2>Teaching Experience</h2>
      <ul class="entries">
        {roles.map((r) => (
          <li>
            <Entry heading={r.role} sub={[r.context, r.level].filter(Boolean).join(', ')} range={formatRange(r.start, r.end)}>
              {r.description && <Prose md={r.description} />}
              {r.subjects.length > 0 && <p class="meta">{r.subjects.join(', ')}</p>}
            </Entry>
          </li>
        ))}
      </ul>
    </section>
  )}

  {hasCourses && (
    <section class="section">
      <h2>Courses I Can Teach</h2>
      {t.course_groups.map((g) => (
        <>
          <h3 class="group">{g.department}</h3>
          <p>{g.courses.join(' · ')}</p>
        </>
      ))}
    </section>
  )}

  <style>
    .group {
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.3;
      margin: 2rem 0 0;
    }
  </style>
</Base>
