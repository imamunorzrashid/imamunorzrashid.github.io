---
import { getEntry } from 'astro:content';
import { footerLinks } from '../lib/links';
import LinkIcon from './LinkIcon.astro';

const profile = await getEntry('profile', 'profile');
if (!profile) throw new Error('Missing src/content/pages/profile.yaml (collection "profile", id "profile")');
const p = profile.data;

const shown = footerLinks(p);
const buildDate = new Date().toISOString().slice(0, 10);
---
<footer class="site-footer wrap">
  <p>
    {shown.map((l, i) => (
      <>
        {i > 0 && ' · '}
        <a href={l.href} class:list={[l.icon && 'with-icon']}>{l.icon && <LinkIcon name={l.icon} />} {l.label}</a>
      </>
    ))}
  </p>
  <p>Last updated {buildDate}</p>
  {p.flag_counter && (
    <p>
      <a href={`https://info.flagcounter.com/${p.flag_counter}`} rel="noopener"><img src={`https://s05.flagcounter.com/count2/${p.flag_counter}/bg_FFFFFF/txt_5C5C5C/border_FFFFFF/columns_2/maxflags_10/viewers_0/labels_0/pageviews_1/flags_0/percent_0/`} alt="Visitor counter by country (Flag Counter)" loading="lazy" width="162" height="154" /></a>
    </p>
  )}
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    padding-block: 2rem 3rem;
    border-top: 1px solid var(--rule);
    font-family: var(--font-sans);
    font-size: 0.9rem;
    color: var(--muted);
  }

  .site-footer p {
    margin: 0 0 0.5rem;
  }
</style>
