---
// An image row: a 4:3 thumbnail on the left (stacked above the text on narrow screens), then the title, meta and slot.
interface Props {
  heading: string;
  href?: string;
  meta?: string;
  image?: string;
  imageAlt?: string;
}

const { heading, href, meta, image, imageAlt = '' } = Astro.props;
---
<div class:list={['work-row', image && 'has-image']}>
  {image && <img src={image} alt={imageAlt} loading="lazy" />}
  <div>
    <h3>{href ? <a href={href}>{heading}</a> : heading}</h3>
    {meta && <p class="meta">{meta}</p>}
    <slot />
  </div>
</div>

<style>
  .work-row {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .work-row img {
    display: block;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--figure-bg);
  }

  h3 {
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0 0 0.15rem;
  }

  .meta {
    margin: 0 0 0.5rem;
  }

  /* The thumbnail takes a fixed 11rem column once there is room for text beside it. */
  @media (min-width: 40rem) {
    .work-row.has-image {
      grid-template-columns: 11rem 1fr;
      gap: 1.25rem;
    }

    .work-row.has-image img {
      max-width: none;
    }
  }
</style>
